# Copy to .env for local development: cp .env.example .env
# The API and the worker read this file; the web app only needs API_URL.

MONGODB_URI=mongodb://127.0.0.1:27017/pulse
REDIS_URL=redis://127.0.0.1:6379
API_PORT=4001
API_URL=http://127.0.0.1:4001
SITE_ORIGIN=http://localhost:3000

# Signs the session cookie. This value is for local development only; the API refuses to start in
# production with it. Generate a real one with: openssl rand -base64 48
JWT_SECRET=dev-only-secret-replace-before-deploying

# Lets the demo login list the seeded accounts. Never turn this on for a real service.
DEMO_LOGIN=true

# Accounts with more followers than this are read by pull instead of pushed into timelines.
FANOUT_THRESHOLD=1000

# Where images are kept: "local" (a folder, for development) or "s3" (S3, R2 or MinIO).
STORAGE_DRIVER=local
MEDIA_DIR=../../.data/media
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_BUCKET=pulse-media
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadmin

# Phrases the moderation worker flags for review, separated by commas.
MODERATION_TERMS=free crypto,buy followers
