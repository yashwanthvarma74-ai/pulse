{
  "name": "@pulse/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Express API: sessions, posts and the cursor-paged feed.",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "seed": "tsx --env-file-if-exists=../../.env src/scripts/seed.ts",
    "explain": "tsx --env-file-if-exists=../../.env src/scripts/explain.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-prometheus": "^0.300.0",
    "@opentelemetry/resources": "^3.0.0",
    "@opentelemetry/sdk-metrics": "^3.0.0",
    "@pulse/core": "*",
    "@pulse/shared": "*",
    "bullmq": "^6.4.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.13",
    "mongodb": "^7.0.0",
    "pino": "^10.0.0",
    "pino-http": "^11.0.0",
    "sharp": "^0.35.0",
    "ws": "^8.18.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "@types/ws": "^8.5.0",
    "@vitest/coverage-v8": "^5.0.3",
    "fast-check": "^4.0.0",
    "supertest": "^7.0.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "vitest": "^5.0.3"
  }
}
