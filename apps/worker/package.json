{
  "name": "@pulse/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "BullMQ workers: fan-out, notifications, media processing and moderation.",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-prometheus": "^0.300.0",
    "@opentelemetry/resources": "^3.0.0",
    "@opentelemetry/sdk-metrics": "^3.0.0",
    "@pulse/core": "*",
    "@pulse/shared": "*",
    "bullmq": "^6.4.0",
    "ioredis": "^6.0.0",
    "mongodb": "^7.0.0",
    "pino": "^10.0.0",
    "sharp": "^0.35.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0"
  }
}
