{
  "name": "pulse",
  "private": true,
  "type": "module",
  "description": "A social feed and communities app that stays fast, correct and private as it grows.",
  "workspaces": [
    "packages/*",
    "apps/*",
    "e2e"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n api,worker,web -c blue,yellow,magenta \"npm run dev -w @pulse/api\" \"npm run dev -w @pulse/worker\" \"npm run dev -w @pulse/web\"",
    "build": "npm run build -w @pulse/api && npm run build -w @pulse/worker && npm run build -w @pulse/web",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "npm run typecheck -ws --if-present",
    "test": "npm run test -w @pulse/shared -w @pulse/core -w @pulse/api -w @pulse/worker -w @pulse/web",
    "seed": "npm run seed -w @pulse/api --",
    "explain": "npm run explain -w @pulse/api",
    "e2e": "npm run test -w @pulse/e2e",
    "size": "size-limit",
    "perf:bundle": "node perf/bundle.mjs",
    "perf:stack": "perf/stack.sh start"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "1.64.0",
    "@size-limit/file": "^11.1.0",
    "chrome-launcher": "^1.2.0",
    "concurrently": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "lighthouse": "^13.0.0",
    "prettier": "^3.3.0",
    "size-limit": "^11.1.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "ws": "^8.18.0"
  }
}
