{
  "name": "pulse",
  "private": true,
  "type": "module",
  "description": "A social feed and communities app that stays fast, correct and private as it grows.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm run dev -w @pulse/api\" \"npm run dev -w @pulse/web\"",
    "build": "npm run build -w @pulse/api && npm run build -w @pulse/web",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "npm run typecheck -ws --if-present",
    "test": "npm run test -ws --if-present",
    "seed": "npm run seed -w @pulse/api --",
    "explain": "npm run explain -w @pulse/api"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "concurrently": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0"
  }
}
