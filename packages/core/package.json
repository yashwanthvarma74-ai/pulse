{
  "name": "@pulse/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Domain logic shared by the API and the worker: data model, privacy policy, feed, queues, media.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./test": "./src/test/context.ts"
